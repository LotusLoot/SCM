rules_version = '2';
// SCM Firestore 보안 규칙 — Firebase 콘솔 → Firestore Database → 규칙 탭에 통째로 붙여 넣고 [게시]
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }
    function myCrew() { return get(/databases/$(database)/documents/users/$(uid())).data.get('crewId', null); }
    function inCrew(cid) {
      return cid != null && exists(/databases/$(database)/documents/crews/$(cid))
        && get(/databases/$(database)/documents/crews/$(cid)).data.members.hasAny([uid()]);
    }

    // 플레이어: 누구나 읽기(랭킹·아레나·방어 팀), 쓰기는 자기 문서만
    match /users/{userId} {
      allow read: if signedIn();
      allow write: if signedIn() && uid() == userId
        && (!('name' in request.resource.data) || (request.resource.data.name is string && request.resource.data.name.size() <= 12))
        && (!('arenaScore' in request.resource.data) || request.resource.data.arenaScore <= 5000);
    }

    // 크루 직급: 크루장 · 부크루장(vices) · 간부(officers) · 단원
    function isVice(c, u) { return c.get('vices', []).hasAny([u]); }
    function isOfficer(c, u) { return c.get('officers', []).hasAny([u]); }
    function isStaff(c, u) { return c.leader == u || isVice(c, u) || isOfficer(c, u); }
    function roleSizeOk(n) { return n.get('vices', []).size() <= 1 && n.get('officers', []).size() <= 3; }
    function removedOf(o, n) { return o.members.toSet().difference(n.members.toSet()); }
    // 간부 이상: 가입 승인·거절, 자기보다 낮은 직급 1명 추방
    function staffEdit(o, n) {
      return isStaff(o, uid())
        && changed().hasOnly(['members', 'pending', 'pnames', 'names', 'vices', 'officers', 'banned'])
        && n.leader == o.leader && n.members.size() <= 10
        && n.members.toSet().difference(o.members.toSet()).difference(o.get('pending', []).toSet()).size() == 0
        && removedOf(o, n).size() <= 1 && !removedOf(o, n).hasAny([o.leader, uid()])
        && (o.leader == uid() || !removedOf(o, n).hasAny(o.get('vices', [])))
        && (o.leader == uid() || isVice(o, uid()) || !removedOf(o, n).hasAny(o.get('officers', [])))
        && n.get('vices', []).toSet() == o.get('vices', []).toSet().difference(removedOf(o, n))
        && n.get('officers', []).toSet() == o.get('officers', []).toSet().difference(removedOf(o, n));
    }
    // 가입 신청: 추방 뒤 24시간은 못 해요
    function notBanned(o) { return !(uid() in o.get('banned', {})) || o.banned[uid()] < request.time.toMillis() - 86400000; }
    // 크루원: 크루 경험치와 자기 기여도만, 한 번에 50까지
    function contribOk(o, n) {
      return n.get('contrib', {}).diff(o.get('contrib', {})).affectedKeys().hasOnly([uid()])
        && n.get('contrib', {}).get(uid(), 0) >= o.get('contrib', {}).get(uid(), 0)
        && n.get('contrib', {}).get(uid(), 0) - o.get('contrib', {}).get(uid(), 0) <= 50;
    }
    match /crews/{cid} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.leader == uid()
        && request.resource.data.members == [uid()]
        && request.resource.data.xp == 0
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 12;
      allow delete: if signedIn() && resource.data.leader == uid();
      allow update: if signedIn() && (
        // 크루장: 무엇이든 (최대 10명, 부크루장 1명, 간부 3명)
        (resource.data.leader == uid() && request.resource.data.members.size() <= 10
          && request.resource.data.members.hasAny([request.resource.data.leader]) && roleSizeOk(request.resource.data))
        // 간부 이상: 승인·거절·추방
        || staffEdit(resource.data, request.resource.data)
        // 아무나: 자기 자신의 가입 신청만 넣거나 빼기
        || (changed().hasOnly(['pending', 'pnames']) && notBanned(resource.data)
          && request.resource.data.pending.toSet().difference(resource.data.pending.toSet())
               .union(resource.data.pending.toSet().difference(request.resource.data.pending.toSet())).hasOnly([uid()]))
        // 크루원: 크루 경험치 · 내 기여도 올리기
        || (changed().hasOnly(['xp', 'contrib']) && resource.data.members.hasAny([uid()])
          && request.resource.data.xp >= resource.data.xp && request.resource.data.xp - resource.data.xp <= 50
          && contribOk(resource.data, request.resource.data))
        // 크루원: 스스로 탈퇴 (직급도 같이 내려놓기)
        || (changed().hasOnly(['members', 'vices', 'officers']) && resource.data.members.hasAny([uid()])
          && resource.data.members.toSet().difference(request.resource.data.members.toSet()).hasOnly([uid()])
          && request.resource.data.members.size() == resource.data.members.size() - 1
          && request.resource.data.get('vices', []).toSet() == resource.data.get('vices', []).toSet().difference([uid()].toSet())
          && request.resource.data.get('officers', []).toSet() == resource.data.get('officers', []).toSet().difference([uid()].toSet()))
      );

      // 크루 협동 현상금: 크루원만, 보스 체력은 줄어들기만
      match /bounty/{week} {
        allow read: if signedIn();
        allow create: if inCrew(cid) && request.resource.data.hp <= 1;
        allow update: if inCrew(cid) && request.resource.data.hp <= resource.data.hp && request.resource.data.hp >= 0;
      }
    }

    // 구역: 우리 크루 장악도는 한 번에 +35까지, 다른 크루·갱단 장악도는 줄어들기만
    match /districts/{did} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.owner == 'npc' && request.resource.data.ctrl.npc == 100;
      allow update: if signedIn() && inCrew(myCrew())
        && changed().hasOnly(['ctrl', 'names', 'owner', 'ownerName', 'ownerColor', 'at'])
        && request.resource.data.ctrl.get(myCrew(), 0) <= 100
        && request.resource.data.ctrl.get(myCrew(), 0) - resource.data.ctrl.get(myCrew(), 0) <= 35
        && request.resource.data.ctrl.get('npc', 0) <= resource.data.ctrl.get('npc', 0)
        && (request.resource.data.owner == resource.data.owner
            || (request.resource.data.owner == myCrew() && request.resource.data.ctrl[myCrew()] >= 100));
    }

    // 도시 소식: 쓰기만, 고치기·지우기 불가
    match /news/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.t is string && request.resource.data.t.size() <= 120
        && request.resource.data.by == uid();
    }

    // 주간 순위 기록: 한 번 만들면 끝
    match /meta/{id} {
      allow read: if signedIn();
      allow create: if signedIn();
    }
  }
}
